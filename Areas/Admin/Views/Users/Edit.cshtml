@model AdminUserFormViewModel

@{
	ViewData["Title"] = "Kullanıcıyı düzenle";
}

<div class="container py-4">
	<div class="mb-4">
		<a asp-area="Admin" asp-controller="Users" asp-action="Index" class="link-secondary text-decoration-none">
			<i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Kullanıcılara dön
		</a>
		<div class="mt-3">
			<span class="page-kicker">Yönetim / Kullanıcılar</span>
			<h1 class="h2 fw-bold mb-1">Kullanıcıyı düzenle</h1>
			<p class="text-muted mb-0">Hesap bilgilerini ve erişim rolünü güncelleyin.</p>
		</div>
	</div>

	@if (TempData["Success"] is string successMessage)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@successMessage
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
		</div>
	}

	<div class="row">
		<div class="col-12 col-lg-8 col-xl-7">
			<form asp-area="Admin" asp-controller="Users" asp-action="Edit" asp-route-id="@Model.Id" method="post">
				@Html.AntiForgeryToken()
				<input asp-for="Id" type="hidden" />
				<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

				<div class="mb-3">
					<label asp-for="Email" class="form-label fw-semibold"></label>
					<input asp-for="Email" class="form-control" type="email" autocomplete="email" />
					<span asp-validation-for="Email" class="text-danger small"></span>
				</div>
				<div class="mb-3">
					<label asp-for="FullName" class="form-label fw-semibold"></label>
					<input asp-for="FullName" class="form-control" autocomplete="name" />
					<span asp-validation-for="FullName" class="text-danger small"></span>
				</div>
				<div class="mb-3">
					<label asp-for="Role" class="form-label fw-semibold"></label>
					<select asp-for="Role" class="form-select">
						<option value="Customer">Müşteri</option>
						<option value="Admin">Admin</option>
					</select>
					<span asp-validation-for="Role" class="text-danger small"></span>
				</div>
				<div class="mb-3">
					<span class="form-label fw-semibold d-block">Hesap durumu</span>
					<span class="badge @(Model.IsLocked ? "text-bg-danger" : "text-bg-success")">
						@(Model.IsLocked ? "Kilitli" : "Aktif")
					</span>
				</div>

				<hr class="my-4" />
				<h2 class="h5 fw-bold mb-3">Şifre değiştir</h2>
				<p class="text-muted small">Şifreyi değiştirmeyecekseniz bu alanları boş bırakın.</p>
				<div class="mb-3">
					<label asp-for="NewPassword" class="form-label fw-semibold"></label>
					<input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
					<span asp-validation-for="NewPassword" class="text-danger small"></span>
				</div>
				<div class="mb-4">
					<label asp-for="ConfirmNewPassword" class="form-label fw-semibold"></label>
					<input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
					<span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
				</div>

				<div class="d-flex flex-wrap gap-2">
					<button type="submit" class="btn btn-primary">
						<i class="bi bi-check-lg me-1" aria-hidden="true"></i> Değişiklikleri kaydet
					</button>
					<a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
