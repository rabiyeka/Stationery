@model IList<AdminUserListItemViewModel>

@{
	ViewData["Title"] = "Kullanıcılar";
	var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="container py-4">
	<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-3 mb-4">
		<div>
			<span class="page-kicker">Yönetim</span>
			<h1 class="h2 fw-bold mb-1">Kullanıcılar</h1>
			<p class="text-muted mb-0">Hesapları, rolleri ve erişim durumlarını yönetin.</p>
		</div>
		<a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn btn-primary">
			<i class="bi bi-person-plus me-1" aria-hidden="true"></i> Kullanıcı ekle
		</a>
	</div>

	@if (TempData["Success"] is string successMessage)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@successMessage
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
		</div>
	}
	@if (TempData["Error"] is string errorMessage)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			@errorMessage
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
		</div>
	}

	@if (Model.Count == 0)
	{
		<div class="border-top border-bottom py-5 text-center">
			<i class="bi bi-people fs-2 text-secondary" aria-hidden="true"></i>
			<h2 class="h5 mt-3">Henüz kullanıcı yok</h2>
			<p class="text-muted">Yeni bir hesap oluşturarak başlayın.</p>
			<a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn btn-outline-primary">Kullanıcı ekle</a>
		</div>
	}
	else
	{
		<div class="table-responsive">
			<table class="table align-middle">
				<thead class="table-light">
					<tr>
						<th scope="col">Kullanıcı</th>
						<th scope="col">Rol</th>
						<th scope="col">Durum</th>
						<th scope="col" class="text-end">İşlemler</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var user in Model)
					{
						<tr>
							<td>
								<div class="fw-semibold">@(string.IsNullOrWhiteSpace(user.FullName) ? "İsim belirtilmemiş" : user.FullName)</div>
								<div class="small text-muted">@user.Email</div>
							</td>
							<td>
								@foreach (var role in user.Roles)
								{
									<span class="badge @(role == "Admin" ? "text-bg-primary" : "text-bg-light") me-1">
										@(role == "Admin" ? "Admin" : role == "Customer" ? "Müşteri" : role)
									</span>
								}
							</td>
							<td>
								<span class="badge @(user.IsLocked ? "text-bg-danger" : "text-bg-success")">
									@(user.IsLocked ? "Kilitli" : "Aktif")
								</span>
							</td>
							<td>
								<div class="d-flex justify-content-end gap-2">
									<a asp-area="Admin" asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id"
									   class="btn btn-sm btn-outline-secondary" title="Düzenle" aria-label="@user.Email kullanıcısını düzenle">
										<i class="bi bi-pencil" aria-hidden="true"></i>
									</a>
									@if (user.Id != currentUserId)
									{
										<form asp-area="Admin" asp-controller="Users" asp-action="ToggleLock" asp-route-id="@user.Id" method="post">
											@Html.AntiForgeryToken()
											<button type="submit" class="btn btn-sm btn-outline-warning"
													title="@(user.IsLocked ? "Kilidi kaldır" : "Hesabı kilitle")"
													aria-label="@(user.IsLocked ? "Kullanıcı kilidini kaldır" : "Kullanıcıyı kilitle")">
												<i class="bi @(user.IsLocked ? "bi-unlock" : "bi-lock")" aria-hidden="true"></i>
											</button>
										</form>
										<form asp-area="Admin" asp-controller="Users" asp-action="Delete" asp-route-id="@user.Id" method="post"
											  onsubmit="return confirm('Bu kullanıcıyı silmek istediğinize emin misiniz?');">
											@Html.AntiForgeryToken()
											<button type="submit" class="btn btn-sm btn-outline-danger" title="Sil" aria-label="@user.Email kullanıcısını sil">
												<i class="bi bi-trash" aria-hidden="true"></i>
											</button>
										</form>
									}
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
</div>
