@model AdminUserCreateViewModel

@{
	ViewData["Title"] = "Kullanıcı oluştur";
}

<div class="container py-4">
	<div class="mb-4">
		<a asp-area="Admin" asp-controller="Users" asp-action="Index" class="link-secondary text-decoration-none">
			<i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Kullanıcılara dön
		</a>
		<div class="mt-3">
			<span class="page-kicker">Yönetim / Kullanıcılar</span>
			<h1 class="h2 fw-bold mb-1">Kullanıcı oluştur</h1>
			<p class="text-muted mb-0">Yeni bir hesap ve erişim rolü tanımlayın.</p>
		</div>
	</div>

	<div class="row">
		<div class="col-12 col-lg-8 col-xl-7">
			<form asp-area="Admin" asp-controller="Users" asp-action="Create" method="post">
				@Html.AntiForgeryToken()
				<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

				<div class="mb-3">
					<label asp-for="Email" class="form-label fw-semibold"></label>
					<input asp-for="Email" class="form-control" type="email" autocomplete="email" />
					<span asp-validation-for="Email" class="text-danger small"></span>
				</div>
				<div class="mb-3">
					<label asp-for="FullName" class="form-label fw-semibold"></label>
					<input asp-for="FullName" class="form-control" autocomplete="name" />
					<span asp-validation-for="FullName" class="text-danger small"></span>
				</div>
				<div class="mb-3">
					<label asp-for="Role" class="form-label fw-semibold"></label>
					<select asp-for="Role" class="form-select">
						<option value="Customer">Müşteri</option>
						<option value="Admin">Admin</option>
					</select>
					<span asp-validation-for="Role" class="text-danger small"></span>
				</div>
				<div class="mb-3">
					<label asp-for="Password" class="form-label fw-semibold"></label>
					<input asp-for="Password" class="form-control" autocomplete="new-password" />
					<span asp-validation-for="Password" class="text-danger small"></span>
				</div>
				<div class="mb-4">
					<label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
					<input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
					<span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
				</div>

				<div class="d-flex flex-wrap gap-2">
					<button type="submit" class="btn btn-primary">
						<i class="bi bi-person-plus me-1" aria-hidden="true"></i> Kullanıcı oluştur
					</button>
					<a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
