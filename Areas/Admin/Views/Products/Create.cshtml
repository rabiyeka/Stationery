@model AdminProductFormViewModel

@{
	ViewData["Title"] = "Yeni ürün";
}

<div class="container py-4">
	<div class="mb-4">
		<a asp-area="Admin" asp-controller="Products" asp-action="Index" class="link-secondary text-decoration-none">
			<i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Ürünlere dön
		</a>
		<div class="mt-3">
			<span class="page-kicker">Yönetim / Ürünler</span>
			<h1 class="h2 fw-bold mb-1">Yeni ürün</h1>
			<p class="text-muted mb-0">Ürün bilgilerini girerek mağazaya ekleyin.</p>
		</div>
	</div>

	<div class="row">
		<div class="col-12 col-lg-8 col-xl-7">
			<form asp-area="Admin" asp-controller="Products" asp-action="Create" method="post">
				@Html.AntiForgeryToken()
				<partial name="_ProductFormFields" model="Model" />
				<div class="d-flex flex-wrap gap-2">
					<button type="submit" class="btn btn-primary">
						<i class="bi bi-check-lg me-1" aria-hidden="true"></i> Ürünü oluştur
					</button>
					<a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
