@model AdminProductFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
<input asp-for="Id" type="hidden" />
<input asp-for="ImageUrl" type="hidden" />

<div class="mb-3">
	<label asp-for="Name" class="form-label fw-semibold"></label>
	<input asp-for="Name" class="form-control" autocomplete="off" />
	<span asp-validation-for="Name" class="text-danger small"></span>
</div>

<div class="mb-3">
	<label asp-for="Description" class="form-label fw-semibold"></label>
	<textarea asp-for="Description" class="form-control" rows="4" maxlength="100"></textarea>
	<span asp-validation-for="Description" class="text-danger small"></span>
</div>

<div class="row g-3 mb-3">
	<div class="col-12 col-md-6">
		<label asp-for="Price" class="form-label fw-semibold"></label>
		<div class="input-group">
			<input asp-for="Price" class="form-control" type="number" min="0.01" step="0.01" />
			<span class="input-group-text">₺</span>
		</div>
		<span asp-validation-for="Price" class="text-danger small"></span>
	</div>
	<div class="col-12 col-md-6">
		<label asp-for="StockQuantity" class="form-label fw-semibold"></label>
		<input asp-for="StockQuantity" class="form-control" type="number" min="0" step="1" />
		<span asp-validation-for="StockQuantity" class="text-danger small"></span>
	</div>
</div>

<div class="row g-3 mb-3">
	<div class="col-12 col-md-6">
		<label asp-for="CategoryId" class="form-label fw-semibold"></label>
		<select asp-for="CategoryId" class="form-select">
			<option value="0">Kategori seçin</option>
			@foreach (var category in ViewBag.Categories)
			{
				<option value="@category.Id">@category.Name</option>
			}
		</select>
		<span asp-validation-for="CategoryId" class="text-danger small"></span>
	</div>
	<div class="col-12 col-md-6">
		<label asp-for="BrandId" class="form-label fw-semibold"></label>
		<select asp-for="BrandId" class="form-select">
			<option value="0">Marka seçin</option>
			@foreach (var brand in ViewBag.Brands)
			{
				<option value="@brand.Id">@brand.Name</option>
			}
		</select>
		<span asp-validation-for="BrandId" class="text-danger small"></span>
	</div>
</div>

