@model AdminBrandIndexViewModel

@{
    ViewData["Title"] = "Markalar";
}

<div class="container py-4">
    <div class="mb-4">
        <span class="page-kicker">Yönetim</span>
        <h1 class="h2 fw-bold mb-1">Markalar</h1>
        <p class="text-muted mb-0">Ürünlerde kullanılacak markaları ekleyin.</p>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-12 col-lg-5 col-xl-4">
            <section aria-labelledby="create-brand-title">
                <h2 id="create-brand-title" class="h5 fw-bold mb-3">Yeni marka ekle</h2>
                <form asp-area="Admin" asp-controller="Brands" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Form.Name" class="form-label fw-semibold"></label>
                        <input asp-for="Form.Name" class="form-control" maxlength="50" autocomplete="off" />
                        <span asp-validation-for="Form.Name" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Marka ekle
                    </button>
                </form>
            </section>
        </div>

        <div class="col-12 col-lg-7 col-xl-8">
            <section aria-labelledby="brand-list-title">
                <h2 id="brand-list-title" class="h5 fw-bold mb-3">Kayıtlı markalar</h2>
                @if (Model.Brands.Count == 0)
                {
                    <div class="border-top border-bottom py-5 text-center">
                        <i class="bi bi-bookmark fs-2 text-secondary" aria-hidden="true"></i>
                        <p class="text-muted mt-3 mb-0">Henüz marka eklenmemiş.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Marka</th>
                                    <th scope="col" class="text-center">Ürün sayısı</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var brand in Model.Brands)
                                {
                                    <tr>
                                        <td class="fw-semibold">@brand.Name</td>
                                        <td class="text-center">@brand.ProductCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}