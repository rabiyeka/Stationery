@model IList<AdminCategoryListViewModel>

@{
	ViewData["Title"] = "Kategoriler";
}

<div class="container py-4">
	<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-3 mb-4">
		<div>
			<span class="page-kicker">Yönetim</span>
			<h1 class="h2 fw-bold mb-1">Kategoriler</h1>
			<p class="text-muted mb-0">Ürün kategorilerini görüntüleyin ve yönetin.</p>
		</div>
		<a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-primary">
			<i class="bi bi-plus-lg me-1"></i> Yeni kategori
		</a>
	</div>

	@if (TempData["Success"] is string successMessage)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@successMessage
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
		</div>
	}
	@if (TempData["Error"] is string errorMessage)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			@errorMessage
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
		</div>
	}

	@if (Model.Count == 0)
	{
		<div class="border-top border-bottom py-5 text-center">
			<i class="bi bi-tags fs-2 text-secondary" aria-hidden="true"></i>
			<h2 class="h5 mt-3">Henüz kategori yok</h2>
			<p class="text-muted">Ürünleri düzenlemek için ilk kategorinizi oluşturun.</p>
			<a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-outline-primary">
				Kategori oluştur
			</a>
		</div>
	}
	else
	{
		<div class="table-responsive">
			<table class="table align-middle">
				<thead class="table-light">
					<tr>
						<th scope="col">Kategori adı</th>
						<th scope="col" class="text-center">Ürün sayısı</th>
						<th scope="col" class="text-end">İşlemler</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var category in Model)
					{
						<tr>
							<td class="fw-semibold">@category.Name</td>
							<td class="text-center">@category.ProductCount</td>
							<td>
								<div class="d-flex justify-content-end gap-2">
									<a asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id"
									   class="btn btn-sm btn-outline-secondary" aria-label="@category.Name kategorisini düzenle" title="Düzenle">
										<i class="bi bi-pencil" aria-hidden="true"></i>
									</a>
									<form asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@category.Id" method="post"
										  onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">
										@Html.AntiForgeryToken()
										<button type="submit" class="btn btn-sm btn-outline-danger" aria-label="@category.Name kategorisini sil" title="Sil">
											<i class="bi bi-trash" aria-hidden="true"></i>
										</button>
									</form>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
</div>
