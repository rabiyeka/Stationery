@model AdminCategoryFormViewModel

@{
	ViewData["Title"] = "Kategoriyi düzenle";
}

<div class="container py-4">
	<div class="mb-4">
		<a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="link-secondary text-decoration-none">
			<i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Kategorilere dön
		</a>
		<div class="mt-3">
			<span class="page-kicker">Yönetim / Kategoriler</span>
			<h1 class="h2 fw-bold mb-1">Kategoriyi düzenle</h1>
			<p class="text-muted mb-0">Kategori bilgilerini güncelleyin.</p>
		</div>
	</div>

	<div class="row">
		<div class="col-12 col-lg-8 col-xl-7">
			<form asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@Model.Id" method="post">
				@Html.AntiForgeryToken()
				<input asp-for="Id" type="hidden" />
				<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

				<div class="mb-3">
					<label asp-for="Name" class="form-label fw-semibold"></label>
					<input asp-for="Name" class="form-control" autocomplete="off" />
					<span asp-validation-for="Name" class="text-danger small"></span>
				</div>

				<div class="mb-4">
					<label asp-for="Description" class="form-label fw-semibold"></label>
					<textarea asp-for="Description" class="form-control" rows="4" maxlength="100"></textarea>
					<span asp-validation-for="Description" class="text-danger small"></span>
					<div class="form-text">En fazla 100 karakter.</div>
				</div>

				<div class="d-flex flex-wrap gap-2">
					<button type="submit" class="btn btn-primary">
						<i class="bi bi-check-lg me-1" aria-hidden="true"></i> Değişiklikleri kaydet
					</button>
					<a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
