@model Stationery.ViewModels.Account.RegisterViewModel

@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    
                    
                    <div class="text-center mb-4">
                        <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                            <i class="bi bi-person-plus-fill fs-4"></i>
                        </div>
                        <h4 class="fw-bold mb-1">Hesap Oluştur</h4>
                        <p class="text-muted small">Kırtasiye dünyasına hemen katılın</p>
                    </div>

                    
                    <form asp-action="Register" method="post">
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3" role="alert"></div>

                        
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label small fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Ad Soyadınız" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="ornek@email.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-semibold"></label>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg fs-6 fw-semibold">
                                Kayıt Ol
                            </button>
                        </div>
                    </form>

                </div>
                <div class="card-footer bg-light border-0 py-3 text-center rounded-bottom">
                    <span class="text-muted small">Zaten hesabınız var mı?</span>
                    <a asp-action="Login" class="text-decoration-none fw-semibold small ms-1">Giriş Yap</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}