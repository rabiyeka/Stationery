@model Stationery.ViewModels.Account.ChangePasswordViewModel

@{
    ViewData["Title"] = "Üyelik Bilgilerim";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <h2 class="fw-bold mb-1">Üyelik bilgilerim</h2>
            <p class="text-muted mb-4">Şifrenizi buradan güncelleyebilirsiniz.</p>
            @if (TempData["Success"] is not null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <form asp-action="Membership" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        <div class="mb-3"><label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" class="form-control" /><span asp-validation-for="CurrentPassword" class="text-danger small"></span></div>
                        <div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" /><span asp-validation-for="NewPassword" class="text-danger small"></span></div>
                        <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
                        <button class="btn btn-primary rounded-pill px-4" type="submit">Şifreyi güncelle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }