@model Stationery.ViewModels.Account.AccountIndexViewModel

@{
    ViewData["Title"] = "Hesabım";
}

<div class="container my-5">
    <h2 class="fw-bold mb-2">Hesabım</h2>
    <p class="text-muted mb-4">Hesabınızla ilgili işlemleri buradan yönetebilirsiniz.</p>

    <div class="row g-4">
        <div class="col-md-4">
            <a asp-action="Orders" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
                    <i class="bi bi-box-seam account-action-icon fs-1 mb-3"></i>
                    <h5 class="fw-bold text-dark">Siparişlerim</h5>
                    <p class="text-muted mb-0">Geçmiş ve aktif siparişlerinizin durumunu görüntüleyin.</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-action="Addresses" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
                    <i class="bi bi-geo-alt account-action-icon fs-1 mb-3"></i>
                    <h5 class="fw-bold text-dark">Adreslerim</h5>
                    <p class="text-muted mb-0">Teslimat adreslerinizi ekleyin ve yönetin.</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-action="Membership" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
                    <i class="bi bi-person-gear account-action-icon fs-1 mb-3"></i>
                    <h5 class="fw-bold text-dark">Üyelik bilgilerim</h5>
                    <p class="text-muted mb-0">Şifrenizi ve üyelik bilgilerinizi yönetin.</p>
                </div>
            </a>
        </div>
    </div>
</div>